{
  "expo": {
    "name": "Xpress Vet",
    "slug": "xpress-vet",
    "version": "1.0.0",
    "scheme": "xpressvet",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/434617fd-5767-4eee-8920-e739e9894092",
      "fallbackToCacheTimeout": 0
    },
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.xpressvet.marketplace",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "We need your location to find nearby vets and pet services.",
        "NSCameraUsageDescription": "Xpress Vet uses the camera to scan product barcodes and QR codes at your point of sale.",
        "NSPhotoLibraryUsageDescription": "Xpress Vet needs photo access to add your business logo, listing photos and receipts.",
        "NSPhotoLibraryAddUsageDescription": "Xpress Vet saves receipts and exported reports to your photo library.",
        "NSContactsUsageDescription": "Xpress Vet can import your contacts as customers into your CRM.",
        "NSFaceIDUsageDescription": "Use Face ID to sign in to your business securely.",
        "NSCalendarsUsageDescription": "Xpress Vet can add appointment and reorder reminders to your calendar.",
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.xpressvet.marketplace",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "CAMERA",
        "READ_CONTACTS",
        "WRITE_CONTACTS",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "READ_CALENDAR",
        "WRITE_CALENDAR",
        "READ_MEDIA_IMAGES"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#E8610A",
          "defaultChannel": "default",
          "sounds": []
        }
      ],
      "expo-mail-composer",
      "expo-secure-store",
      "expo-web-browser",
      "expo-localization"
    ],
    "web": {
      "bundler": "metro",
      "output": "single",
      "title": "Xpress Vet — Nigeria's Pet Care Marketplace",
      "description": "Find trusted vets, kennels, and pet shops near you across Nigeria.",
      "favicon": "./assets/icon.png"
    },
    "notification": {
      "icon": "./assets/icon.png",
      "vapidPublicKey": "BDi-uYFdjPBqeosVGoz6Nt6Vr1guFnoymo2Udvmbt01pbnAwmOwXrqwbhr04BSWOii6MunO-IpL4CxfQpTwW19w",
      "serviceWorkerPath": "/expo-service-worker.js"
    },
    "extra": {
      "eas": {
        "projectId": "434617fd-5767-4eee-8920-e739e9894092"
      }
    },
    "owner": "xpressvetmarketplace"
  }
}
